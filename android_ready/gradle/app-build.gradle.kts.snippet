// PocketWorld Android capture — Gradle additions for android/app/build.gradle.kts.
// SNIPPET. Merge into the existing android { } block; do not use as a file.
//
// =============================================================================
// 16 KB PAGE SIZE
// =============================================================================
// Verified against https://developer.android.com/guide/practices/page-sizes:
//
//   Deadline, verbatim: "Starting February 1, 2027, if your app updates don't
//   support 16 KB memory page sizes, you won't be able to release these
//   updates."  (Applies to apps targeting Android 15 / API 35+ on 64-bit
//   devices.)  This is the real date. The widely repeated 2025-11-01 was an
//   earlier, narrower milestone and is not the one that governs us.
//
//   Toolchain, verbatim: "you need to upgrade to Android Gradle Plugin (AGP)
//   version 8.5.1 or higher", and "If you update your tools to the latest
//   versions (AGP version 8.5.1 or higher and NDK version r28 or higher) and
//   use 16 KB-compatible prebuilt dependencies, then your app is 16 KB
//   compatible by default".
//
// Three things must all hold, and only the third is actually checkable:
//   1. AGP >= 8.5.1        -> zip alignment of uncompressed .so at 16 KB
//   2. NDK >= r28          -> ELF segment alignment at 16 KB in what WE build
//   3. every prebuilt .so  -> including xrslam's, and anything Flutter plugins
//                             drag in. A single 4 KB-aligned prebuilt fails the
//                             whole APK, and nothing in the build warns you.
//      -> android_ready/scripts/verify_16kb.sh is the check for (2) and (3).

android {
    // API 35+ is what puts us under the 16 KB requirement in the first place.
    compileSdk = 35

    defaultConfig {
        // 24 is the floor for the capture layer as written:
        //   ApplicationExitInfo      API 30  (guarded at runtime)
        //   PowerManager thermal     API 29/30 (guarded at runtime)
        //   DISTORTION_CORRECTION    API 28  (guarded at runtime)
        //   TYPE_ACCELEROMETER_UNCALIBRATED  API 26
        //   registerListener(..., maxReportLatencyUs, handler)  API 19
        // Everything above 24 is behind an explicit SDK_INT check, so 24 is a
        // real floor rather than a hopeful one.
        minSdk = 24
        targetSdk = 35

        ndk {
            // xrslam ships arm64 only. Do not add armeabi-v7a: 16 KB pages are
            // a 64-bit concern and a 32-bit ABI would add an untested target.
            abiFilters += listOf("arm64-v8a")
        }

        // [pw 2026-09-22] 🔴 这一段现在是**死配置**:下面刻意不挂
        // `externalNativeBuild { cmake { path } }`(理由见那里),没有 CMake
        // 目标时这些 arguments/cppFlags 谁也不读。留着是为了在改回
        // externalNativeBuild 时不丢这两行的依据;等价的保证现在由
        // `build_transport.sh` 的 16 KB 闸(scripts/check_elf_align.py)给出,
        // 它检查的是**产物本身**而不是构建意图。
        // externalNativeBuild {
        //     cmake {
        //         arguments += listOf("-DANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES=ON")
        //         cppFlags += listOf("-DPW_ANDROID_CAPTURE=1")
        //     }
        // }
    }

    // [pw 2026-09-22] 没有这一段,`android_ready/kotlin/` 里的 .kt 根本不参与
    // 构建 —— 2026-09-22 之前 `PwXrslamTransport` 全仓零引用,一半原因就在
    // 这里:snippet 只写了 16 KB 那一档,从没把源码接进来。
    sourceSets {
        getByName("main") {
            java.srcDirs("../../android_ready/kotlin")
            // 预编译的引擎核心。CMakeLists 对它做 SHA256 校验,改一个字节
            // 就 FATAL_ERROR,所以它不需要额外的构建期守卫。
            jniLibs.srcDirs("../../android_ready/native/xrslam/libs")
        }
    }

    // 🔴 **刻意不在这里挂 `externalNativeBuild { cmake { path = … } }`。**
    // `libs/arm64-v8a/` 里已经有一份 `libpw_xrslam_transport.so`,而
    // CMake 目标叫的也是 `pw_xrslam_transport` ⇒ 两条路径会产出同名
    // `lib/arm64-v8a/libpw_xrslam_transport.so`,AGP 直接报
    // "More than one file was found with OS independent path"。
    //
    // 所以两份 .so 走同一种口径:**收据绑定的预编译产物**。
    //   · libxrslam_generic_4beb1a9.so  <- native/xrslam/build_generic_core.sh
    //                                      + core_build_receipt.json
    //   · libpw_xrslam_transport.so     <- native/xrslam/build_transport.sh
    //                                      + transport_build_receipt.json
    // 防陈旧的闸在 `build_transport.sh` 里:它用 `nm -D` 把 .so 的
    // `Java_com_pocketworld_capture_*` 导出与 `PwXrslamTransport.kt` 的
    // `external fun native*` 声明逐项对齐,不一致就退出 1。
    // 🔴 改了 `PwXrslamTransport.{kt,cpp}` 就必须重跑 `build_transport.sh`,
    //    否则装到机器上是 `UnsatisfiedLinkError`(2026-09-22 就踩到过:
    //    8 月那份 .so 只导出 5 个符号,新加的 3 个不在里面)。

    packaging {
        jniLibs {
            // Must stay true. Compressed .so cannot be mapped directly, which
            // is the whole point of the 16 KB alignment work.
            useLegacyPackaging = false
        }
    }

    // [pw 2026-09-22] r28 → r29. 钉的必须是**实际造出产物的那一版**:
    //   · libxrslam_generic_4beb1a9.so  -> core_build_receipt.json: 29.0.14206865
    //   · libpw_xrslam_transport.so     -> transport_build_receipt.json: 29.0.14206865
    // 此前这里写 r28,而两份收据都写 r29 —— 版本号对不上就等于没钉。
    ndkVersion = "29.0.14206865" // r29. Pin it: an unpinned NDK is a silent
                                 // 16 KB regression waiting to happen.
}

dependencies {
    // No new runtime dependency. The capture layer uses only platform APIs and
    // the Flutter embedding that is already on the classpath.
}

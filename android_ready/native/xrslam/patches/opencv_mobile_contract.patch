diff --git a/CMakeLists.txt b/CMakeLists.txt
index 663d7e0..be51613 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -332,6 +332,9 @@ OCV_OPTION(WITH_OPENMP "Include OpenMP support" OFF

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 6917617..9ede6b2 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,18 +14,34 @@ option(XRSLAM_ENABLE_THREADING "..." OFF)
 option(XRSLAM_PC_HEADLESS_ONLY "..." OFF)
 option(XRSLAM_IOS "..." OFF)
 option(XRSLAM_TEST "..." OFF)
+option(XRSLAM_CROSS_PLATFORM_GENERIC
+       "Build the same upstream generic algorithm branch on every platform"
+       OFF)
 
-if(IOS)
+if(IOS AND NOT XRSLAM_CROSS_PLATFORM_GENERIC)
   set(XRSLAM_IOS ON)
   set(XRSLAM_ENABLE_THREADING ON)
   #set(XRSLAM_ENABLE_DEBUG_INSPECTION OFF CACHE BOOL "..." FORCE)
 endif()
 
 
-if(NOT IOS)
+if(NOT IOS AND NOT XRSLAM_CROSS_PLATFORM_GENERIC)
   set(XRSLAM_PC ON)
 endif()
 
+if(XRSLAM_CROSS_PLATFORM_GENERIC)
+  set(XRSLAM_IOS OFF)
+  set(XRSLAM_ENABLE_THREADING OFF)
+  set(XRSLAM_PC OFF)
+  # `-fchar8_t` keeps upstream spdlog 1.3.1/fmt 5.3 compatible with modern
+  # Apple and Android libc++ while preserving the exact pinned dependency.
+  add_compile_options(-ffp-contract=off -fno-fast-math -fchar8_t)
+  # PocketWorld's production SfM already embeds Ceres 2.2. Rename only the
+  # pinned XRSLAM Ceres 1.14 C++ namespace so the final app cannot resolve an
+  # XRSLAM call against the ABI-incompatible product solver by link order.
+  add_compile_definitions(ceres=pw_xrslam_ceres_1_14)
+endif()
+
 add_subdirectory(xrslam)
 add_subdirectory(xrslam-extra)
 add_subdirectory(xrslam-interface)

diff --git a/cmake/depends/ceres-solver.cmake b/cmake/depends/ceres-solver.cmake
index 600178e..9f5bd99 100644
--- a/cmake/depends/ceres-solver.cmake
+++ b/cmake/depends/ceres-solver.cmake
@@ -22,7 +22,13 @@ if(NOT TARGET depends::ceres-solver)
   set(CXX11_THREADS ON CACHE BOOL "" FORCE)
   set(TBB OFF CACHE BOOL "" FORCE)
   set(OPENMP OFF CACHE BOOL "" FORCE)
-  set(LAPACK ON CACHE BOOL "" FORCE)
+  if(XRSLAM_CROSS_PLATFORM_GENERIC)
+    # Keep the solver backend identical on Apple and Android. Accelerate is an
+    # Apple-only implementation detail, not part of the generic baseline.
+    set(LAPACK OFF CACHE BOOL "" FORCE)
+  else()
+    set(LAPACK ON CACHE BOOL "" FORCE)
+  endif()
   set(MINIGLOG_MAX_LOG_LEVEL 0 CACHE STRING "" FORCE)
   set(EIGEN_PREFER_EXPORTED_EIGEN_CMAKE_CONFIGURATION OFF CACHE BOOL "" FORCE)
   set(EIGEN_INCLUDE_DIR ${depends-eigen-source-dir} CACHE PATH "" FORCE)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocketworld.invalid/schemas/basalt-vio-heartbeat-v1.json",
  "title": "Basalt VIO iPhone benchmark heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "receipt_state", "sequence", "monotonic_ns", "written_at_utc", "started_receipt_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "format": "uuid"},
    "receipt_state": {"const": "started"},
    "sequence": {"type": "integer", "minimum": 0},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "written_at_utc": {"type": "string", "format": "date-time"},
    "started_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

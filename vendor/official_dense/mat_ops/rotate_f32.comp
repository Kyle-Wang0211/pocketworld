#version 450
// [TILED-ROTATE 2026-08-30] 32x32 共享内存分块转置。
//
// 为什么要改:原实现 local_size=(32,1,1),每线程一个元素,
//   output_index = ((width-1-input_x) * output_pitch >> 2) + input_y
// 相邻线程(input_x 相邻)的写地址相隔一整行 ⇒ **写完全非合并**。
// 实测 20 轮 rotate 搬 36.7 GB 用了 20.4 s = 1.8 GB/s,
// 只有 M3 Pro 带宽的约 1.2%。
//
// 为什么无损:这个 kernel 不做任何算术,只是把同一组标量按同一个置换
//   (ox, oy) = (iy, width-1-ix)
// 搬到目标位置。分块只改变**搬运顺序与访存形态**,每个目标位置写入的
// 值与来源位置一一对应且完全相同 ⇒ 按构造逐字节相同。
// 写入无重叠(置换是双射),所以块间顺序无关紧要。
//
// 分块后两端都合并:
//   读:线程 x 连续 ⇒ ix 连续 ⇒ 输入行内连续。
//   写:线程 x 连续 ⇒ ox = iy 连续 ⇒ 输出行内连续。
// 共享数组补一列(33)消除 bank conflict。
layout(local_size_x = 32, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
  float values[];
} input_data;

layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
  float values[];
} output_data;

layout(push_constant) uniform PushConstants {
  int width;
  int height;
  int input_pitch_bytes;
  int output_pitch_bytes;
  // [LAYER-FUSE] 一次 dispatch 处理全部层,层号取 gl_WorkGroupID.z。
  int plane_elements;
} pc;

const int kTile = 32;
shared float tile[kTile][kTile + 1];

void main() {
  int layer_base = int(gl_WorkGroupID.z) * pc.plane_elements;
  int tile_x = int(gl_WorkGroupID.x) * kTile;
  int tile_y = int(gl_WorkGroupID.y) * kTile;
  int tx = int(gl_LocalInvocationID.x);
  int ty = int(gl_LocalInvocationID.y);
  int input_stride = pc.input_pitch_bytes >> 2;
  int output_stride = pc.output_pitch_bytes >> 2;

  // 载入:每线程 4 行,读地址沿 x 连续。
  for (int r = 0; r < kTile; r += 8) {
    int ix = tile_x + tx;
    int iy = tile_y + ty + r;
    if (ix < pc.width && iy < pc.height) {
      tile[ty + r][tx] = input_data.values[layer_base + iy * input_stride + ix];
    }
  }

  barrier();

  // 写出:(ox, oy) = (iy, width - 1 - ix)。让 ox 沿线程 x 连续。
  for (int r = 0; r < kTile; r += 8) {
    int iy = tile_y + tx;          // → ox
    int ix = tile_x + ty + r;      // → oy = width - 1 - ix
    if (ix < pc.width && iy < pc.height) {
      int ox = iy;
      int oy = pc.width - 1 - ix;
      output_data.values[layer_base + oy * output_stride + ox] =
          tile[tx][ty + r];
    }
  }
}

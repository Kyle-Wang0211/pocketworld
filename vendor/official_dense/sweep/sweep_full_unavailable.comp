#version 450
#extension GL_GOOGLE_include_directive : require

// Complete mechanical source translation of COLMAP 4.1.1 a0d785f
// SweepFromTopToBottom. patch_match_cuda.cu SHA-256:
// 1aebd4482de0ea6f1f3aad45150c09e0479119c607a843959c8aaa381c0d4448
//
// CONTRACT_TEST_ONLY_NOT_RUNNABLE: the syntax-test branch consumes a supplied
// draw stream and records only its cursor. It is not an RNG implementation and
// must never enter a runtime shader bundle. Normal compilation fails closed.


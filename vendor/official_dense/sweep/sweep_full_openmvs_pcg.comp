#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_GOOGLE_include_directive : require

// Complete mechanical source translation of COLMAP 4.1.1 commit
// a0d785fba74b2664f31edc4a29026a8b27c00f67 SweepFromTopToBottom.
// patch_match_cuda.cu SHA-256:
// 1aebd4482de0ea6f1f3aad45150c09e0479119c607a843959c8aaa381c0d4448
// OpenMVS-PCG expressions: commit
// 8efd9c48e7249b4256ca3a778cb6bf062b871771, PatchMatchMetal.metal SHA-256:
// 1e614e559d1b7ae6fb29e2525bae784023fc0b3b5f068dc46c24027cab9e6a68
//
// COLMAP 4.1.1 sweep/control flow + OpenMVS-PCG adaptation. The only semantic
// substitution is one persistent uint32 OpenMVS-PCG state and a one-for-one
// replacement of each existing curand_uniform draw. This is neither exact
// CUDA/XORWOW nor native OpenMVS Metal.
// REFERENCE_ONLY_NON_RUNNABLE: production RNG and sweep dispatch stay disabled.

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

const int kMaxSources = 10;

layout(constant_id = 2) const bool kGeomConsistencyTerm = false;
layout(constant_id = 3) const bool kFilterPhotoConsistency = false;
layout(constant_id = 4) const bool kFilterGeomConsistency = false;
const uint kFinalGeometricMask = 7u;
// FINAL_MASK_REUSES_FINAL_SCHEDULED_SWEEP: mask 7 sets all three booleans on
// the final already-scheduled invocation. It does not introduce sweep 21.

layout(set = 0, binding = 0, std430) buffer DepthMap {
  float values[];
} depth_map;
layout(set = 0, binding = 1, std430) buffer NormalMap {
  float values[];
} normal_map;
layout(set = 0, binding = 2, std430) buffer CostMap {

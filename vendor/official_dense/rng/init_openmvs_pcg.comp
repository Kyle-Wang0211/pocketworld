#version 450
#extension GL_GOOGLE_include_directive : require

#include "openmvs_pcg_initialization_layout.glsl"

layout(local_size_x = 32, local_size_y = 16, local_size_z = 1) in;

void main() {
  uvec2 pixel = gl_GlobalInvocationID.xy;
  if (pixel.x >= pc.width || pixel.y >= pc.height) {
    return;
  }
  uint unique_block_index =
      gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
  uint seed_low = unique_block_index * 512u +
      gl_LocalInvocationID.y * 32u + gl_LocalInvocationID.x;
  ColmapXorwowState state = ColmapXorwowInitialize(seed_low, 0u);
  StoreColmapXorwowState(pixel.y, pixel.x, pc.width, pc.height, state);
}

     def bpp_loss(self, likelihoods):
         return torch.log(likelihoods).sum()
 
+    def _ctx(self, tensor, *, chroma=False):
+        """Return the context view of a coefficient tensor.
+
+        Registered per-frequency context normalisation. Only ever call this on a
+        tensor that flows into a network; a coding target must stay in its raw
+        integer domain or the coded alphabet changes. Every luma context here is
+        either a whole 64-channel sub-band or a prefix of the frequency ordering,
+        so slicing the prior to the tensor's channel count is always aligned.
+
+        A model without the registered buffers returns the tensor unchanged, so
+        the patched file is a behavioural no-op for the control arm.
+        """
+        if not getattr(self, "_context_normalisation", False):
+            return tensor
+        if chroma:
+            return tensor / self._context_chroma_scale
+        return tensor / self._context_luma_scale[:, : tensor.shape[1]]
+

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Privacy manifest for the PocketWorld app target.

  Required since 2024-05-01: App Store Connect will not accept an app
  that uses a "required reason API" without describing that use here.
  Without this file the upload is rejected with ITMS-91053 (Missing API
  Declaration) — that is an upload-time rejection, so the build never
  even reaches review.

  Scope note: this file declares ONLY what the app's own code does.
  Third-party SDKs must ship their own manifests — Apple: "Your
  third-party SDK can't rely on the privacy manifest files for apps that
  link the third-party SDK". Verified locally: 7 of the 12 Flutter
  plugins already bundle one (shared_preferences_foundation,
  path_provider_foundation, camera_avfoundation,
  sensors_plus, url_launcher_ios, background_downloader, app_links);
  [2026-08-22] file_picker 已从 pubspec 移除(「+」的上传入口在 f41f676
  删除后它的调用点归零),故不再计入 —— 原文为 "8 of the 13";
  integration_test is test-only and never ships; onnxruntime,
  thermion_flutter and video_thumbnail were checked and touch no
  required-reason API; pw_hevc is ours and carries its own manifest.

  Deliberately NOT copied from a blog boilerplate. A privacy manifest is
  an attestation to Apple about what this app actually does, so every
  entry below corresponds to a verified call site.
-->
<plist version="1.0">
<dict>
  <!-- No tracking, no ad networks, no third-party analytics or crash SDK.
       Verified by audit: the repo contains no Sentry/Firebase/Crashlytics/
       Mixpanel/Amplitude/Segment integration, and the native iOS code has
       zero network egress. -->
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array/>

  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <!-- Call site: OfficialAetherARKitPlugin.swift reads the app
           executable's own modification date to derive a build stamp for
           on-device diagnostics. C617.1 covers metadata of files inside
           the app's own container.
           TODO: this API use is avoidable — injecting the build stamp
           into Info.plist at build time removes the call entirely, after
           which this whole entry can be deleted. Deferred because that
           Swift file is being actively modified on another branch. -->
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>C617.1</string>
      </array>
    </dict>
  </array>

  <key>NSPrivacyCollectedDataTypes</key>
  <array>
    <dict>
      <!-- Email is collected for account creation / sign-in only, and is
           linked to the account by definition. Not used for tracking. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEmailAddress</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- Published works: title, description, bio, report text.
           Source photos stay on device and are never uploaded, which is
           why PhotosorVideos is NOT declared — declaring it would
           misstate what leaves the device. (There is also no avatar
           upload feature: profiles.avatar_url exists as a column but no
           client write path — verified 2026-08-24.) -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeOtherUserContent</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <!-- [2026-08-24] Internal research / model training on uploaded
             works, per user agreement §6.3 and privacy policy §1(3).
             Constant verified against the official purpose enum page. -->
        <string>NSPrivacyCollectedDataTypePurposeOther</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] Phone-number sign-in is wired
           (phone_sign_in_view.dart -> signInWithOtp/verifyOTP; the
           number lands in auth.users.phone). Apple: hashed still counts. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypePhoneNumber</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] Apple's User ID definition names "screen name,
           handle, account ID" verbatim — profiles.display_name/handle
           plus the account UUID are exactly this. This was a PRE-EXISTING
           gap, not introduced by today's features. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeUserID</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] IP-derived province-level region, stored
           (works.publish_region / profiles.last_region) and publicly
           displayed. Apple's guidance: when you collect and store an IP,
           declare per its use — coarse location here. Coarse Location is
           defined by resolution (below 3-decimal lat/long), not by
           source, so IP-derived qualifies. The raw IP kept in
           audit_logs is part of the same collection event and serves
           security — no separate Diagnostics declaration, since no
           diagnostics SDK exists and the policy states both uses. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] The published point cloud is literally a scan of
           the user's surroundings — Apple's Environment Scanning
           ("mesh, planes, scene classification, and/or image detection
           of the user's surroundings") fits it better than
           OtherUserContent alone. Declared alongside, not instead. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeEnvironmentScanning</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <!-- [2026-08-24] Internal research / model training on uploaded
             works, per user agreement §6.3 and privacy policy §1(3).
             Constant verified against the official purpose enum page. -->
        <string>NSPrivacyCollectedDataTypePurposeOther</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] Likes and view counts are stored server-side
           (work_likes / work_views) — Product Interaction. No analytics
           SDK involved; server-side app data still counts as collected. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeProductInteraction</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
        <!-- [2026-08-24] First-party analytics (pw_analytics.dart ->
             own analytics_events table, zero third-party SDKs). -->
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
    <dict>
      <!-- [2026-08-24] Self-built crash/error capture: pw_analytics.dart
           installErrorHandlers() chains FlutterError.onError and
           PlatformDispatcher.onError into app_error events (truncated
           message + 12 stack frames, no user content). First-party only;
           retention 180 days server-side. -->
      <key>NSPrivacyCollectedDataType</key>
      <string>NSPrivacyCollectedDataTypeCrashData</string>
      <key>NSPrivacyCollectedDataTypeLinked</key>
      <true/>
      <key>NSPrivacyCollectedDataTypeTracking</key>
      <false/>
      <key>NSPrivacyCollectedDataTypePurposes</key>
      <array>
        <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
      </array>
    </dict>
  </array>
</dict>
</plist>

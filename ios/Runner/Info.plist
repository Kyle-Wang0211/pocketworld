<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- 2026-05-19: enable capture session export via Finder + Files app.
	     Lets user drag ~/Documents/captures/<id>/photos/ from iPhone to Mac
	     without tethered capture. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 2026-04-28 (Exp 5): FLTEnableImpeller=false was the self-inflicted
	     bug. Earlier diagnosis blamed Impeller's "fopen failed for data file:
	     errno = 2" for the black screen, but Exp 1 (hello_ios26) proved
	     Impeller works fine on iOS 26.3.1 and that fopen warning is harmless
	     (Impeller invalidates cache and keeps going). Removing this key so
	     Flutter falls back to its default Impeller-on-iOS behaviour. -->
	<!-- <key>FLTEnableImpeller</key>
	<false/> -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>PocketWorld</string>
	<key>PWBuildExperimentMarker</key>
	<string>future-jxl-lossless-archive-v1+transient-ar-previews-v1+future-official-zpaq-db-archive-v1+official-archive-bgprocessing-v1+sqlite-dual-candidate-archive-v2</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>pocketworld_flutter</string>
	<key>PWBuildMarker</key>
	<string>permanent-project-delete-20260725</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Capture flow needs camera + IMU. Strings shown to the user
	     on first prompt; iOS aborts launch with a crash if they're
	     missing for any API the app actually calls. -->
	<key>NSCameraUsageDescription</key>
	<string>方寸间需要使用相机来扫描你的物体并生成 3D 模型。</string>
	<key>NSMotionUsageDescription</key>
	<string>方寸间使用运动传感器在拍摄时实时引导你绕物体一圈。</string>
	<!-- ARKit is OPTIONAL: the dome capture path uses ARKit world-
	     tracking when available, and falls back to a sensors_plus +
	     Madgwick AHRS path on devices that don't support
	     ARWorldTrackingConfiguration. We deliberately do NOT add
	     `arkit` to UIRequiredDeviceCapabilities so older devices
	     still install the app — runtime check via
	     `ARWorldTrackingConfiguration.isSupported` gates the AR
	     entry point. -->
	<!-- Thermion (Filament FFI) requires iOS 13+. Our Podfile already
	     targets 14.0 so the runtime guard is just defensive — App Store
	     will reject the binary if any embedded framework's plist
	     declares an older MinimumOSVersion. See
	     ios/scripts/thermion_minos_fix.sh for the post-archive patch. -->
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- Firebase SDK (especially FirebaseAuth / Firestore) performs mDNS
	     probing on first launch; iOS 14+ gates that behind a user
	     consent dialog. Providing a clear rationale avoids the launch
	     freezing while Firebase.initializeApp() is blocked waiting for
	     the user's choice. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Aether3D 使用本地网络以便和云端服务（登录、同步、上传训练任务）进行快速连接。</string>
	<!-- EXP 9 (2026-04-28): Flutter stable 3.41.8 on iOS 26 requires
	     Scene-based lifecycle. Without this manifest the Flutter engine
	     never attaches its FlutterView to a window — raster thread stays
	     parked in mach_msg_receive and the first frame never flips.
	     Shape copied verbatim from /tmp/hello_stable (which paints). -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- background_downloader uses URLSessionConfiguration.background to
	     keep video uploads running when the user backgrounds the app or
	     locks the screen. iOS requires UIBackgroundModes to declare
	     "fetch" so the system keeps the BackgroundURLSession alive and
	     wakes the app on completion. Without this, dio's foreground
	     upload would silently abort the moment the user switches apps —
	     the bug observed in PocketWorld v3 ("Processing failed: 上传过程
	     中应用退出"). See lib/upload/aether_api_client.dart. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<!-- BGContinuedProcessingTask (iOS 26) keeps the SfM finalize running when
	     the user backgrounds the app mid-solve. The identifier MUST be prefixed
	     with the EXACT case-sensitive bundle id (com.kyle.PocketWorld) — dasd
	     matches it string-level, and a lowercase form is silently dropped.
	     See ios/Runner/OfficialReconUmbrella.swift. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.kyle.PocketWorld.official.archive</string>
		<string>com.kyle.PocketWorld.official.recon</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>

# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  # 2026-04-27 (evening): direct-launch crash on iPhone 14 Pro / iOS
  # 26.3.1. Crash log pinpointed `swift_getObjectType +40` inside
  # `SharedPreferencesPlugin.register(with:)` — Swift class metadata
  # couldn't be resolved at cold-launch when LLDB wasn't attached.
  # Standard Flutter + Firebase + iOS 26 fix is to flip Pods to use
  # frameworks with static linkage: CocoaPods produces .framework
  # bundles (which correctly export Swift class metadata) but links
  # them statically into the Runner binary (avoiding runtime dylib
  # issues).
  #
  # `:linkage => :static` preserves the zero-dylib distribution
  # profile the pre-Firebase Podfile comment cared about; it's how
  # Firebase-using Flutter apps are expected to configure today.
  #
  # use_modular_headers! stays — still needed by Firebase's Swift
  # pods to import their non-modular Objective-C deps.
  # EXP 3 (2026-04-28): Exp 2 ruled out aether3d_ffi / Dawn. Now test if
  # `use_frameworks! :linkage => :static` + `use_modular_headers!` combo
  # is the culprit (classic static-framework double-initialization / symbol
  # clash pattern). Comment both out and fall back to the stock default
  # (no `use_frameworks!` at all → plugins ship as static libraries;
  # Firebase pods that *require* modular headers will install them on a
  # per-pod basis via :modular_headers => true inside the pod() call).
  # use_frameworks! :linkage => :static   ← static linkage removed (Exp 3)
  use_modular_headers!                     # required by Firebase Swift pods
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  # Restored 2026-04-28: Exp 2 ruled this pod out. The real root cause of
  # the black-screen was missing UIApplicationSceneManifest + SceneDelegate
  # (see ios/Runner/SceneDelegate.swift). Re-enabling Dawn-backed scene
  # renderer.
  #
  # 2026-07-05: switched to the pocketworld-LOCAL fork of the podspec.
  # Same shared dist for everything EXCEPT libglomap_core.a, vendored at
  # vendor/aether_ffi/ at the Jun-29 COLMAP-4.0.4 revision that carries the
  # streaming-SfM finalize_async/status symbols (the shared sfm archives
  # predate them → on-device dlsym "symbol not found" at finalize). See
  # vendor/aether_ffi/aether3d_ffi.podspec header for the exact link deltas.
  pod 'aether3d_ffi', :path => '../vendor/aether_ffi'
  # Independent dynamic SfM image for the "官方" capture route. The framework
  # exports only pwofficial_*; it cannot fall back to the self-route pwsfm_* ABI.
  pod 'official_sfm', :path => '../vendor/official_sfm'

  # [pw][vio] XRSLAM (RD-VIO) 官方五函数 C ABI。Dart 统一配置与判决；
  #   两端固定 OpenCV 4.0.1 / Ceres 1.14 和同一 generic 编译契约。
  pod 'xrslam', :path => '../vendor/xrslam'
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # [2026-08-22 Flutter 3.47 升级] 阈值 13.0 → 15.0。
    # Flutter 3.47 的 Flutter.podspec 声明 deployment_target 15.0,
    # flutter_additional_ios_build_settings 会把各 pod 设成 15.0,届时
    # 本守卫不会触发(15.0 < 15.0 为假);它只兜住 deployment target 为
    # nil 的 pod —— 那种情况下必须给到 15.0,否则 Swift 模块与
    # Flutter.framework 的最低版本不匹配会直接编译失败。
    target.build_configurations.each do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || current.to_f < 15.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
  end

  # Thermion 0.3.4's ios/thermion_flutter.podspec line 25 ships:
  #   'OTHER_CFLAGS' => '"-fvisibility=default" "$(inherited)"'
  # The quoted "$(inherited)" wraps every inherited flag (including the
  # -fmodule-map-file=... chain CocoaPods generates for use_modular_headers!)
  # into one giant argument with leading whitespace, which clang then
  # tries to open as a file → "no such file or directory: ' -fmodule-map-file=...".
  # Strip the quotes from the generated Pods-Runner/Pods-RunnerTests
  # xcconfigs each pod install. Drop this hook when Thermion fixes upstream
  # (file an issue at github.com/nmfisher/thermion if it lingers).
  bad = '"-fvisibility=default" "$(inherited)"'
  good = '-fvisibility=default'
  Dir[File.join(installer.config.installation_root, 'Pods/Target Support Files/Pods-*/*.xcconfig')].each do |xcconfig|
    contents = File.read(xcconfig)
    if contents.include?(bad)
      File.write(xcconfig, contents.gsub(bad, good))
    end
  end

  # For App Store uploads, also run `bash ios/scripts/thermion_minos_fix.sh`
  # AFTER `flutter build ios --release` and BEFORE `xcodebuild archive`.
  # That script re-stamps MinimumOSVersion=13.0 inside the embedded
  # thermion_dart.framework/Info.plist directly, which is what App Store
  # Connect validates (and what the deployment-target override above
  # cannot reach for prebuilt binary frameworks).

  # ── onnxruntime-c force_load (MobileSAM via dart:ffi) ─────────────────
  #
  # The `onnxruntime` Flutter plugin (1.4.1) reaches into the
  # onnxruntime C library at runtime via dart:ffi
  # `DynamicLibrary.lookup('OrtSessionOptionsAppendExecutionProvider_CPU')`
  # and friends. The onnxruntime-c pod ships those symbols inside
  # `onnxruntime.xcframework`, and Pods-Runner.xcconfig already links
  # `-framework "onnxruntime"` — that's enough to satisfy the static
  # linker for any C function some Obj-C code (the onnxruntime-objc
  # wrapper) references by name.
  #
  # But the wrapper doesn't reference every C symbol — only the ones
  # its own Obj-C surface needs. The rest get dead-stripped, so
  # `dlsym(RTLD_DEFAULT, "OrtSessionOptionsAppendExecutionProvider_CPU")`
  # at Dart-side warmup returns NULL and `MobileSamInference.warmup()`
  # explodes with `symbol not found`.
  #
  # `-force_load` tells the linker to retain every symbol in the
  # specified framework binary, regardless of static reachability.
  # Bloats the Runner binary by ~30 MB (the entire onnxruntime C
  # runtime). Worth it — SAM is on the critical capture-quality path.
  #
  # We patch the generated xcconfig directly (not via
  # `config.build_settings = ...` on the ruby Project) because
  # CocoaPods writes the xcconfig in an earlier install phase than
  # the post_install hook fires; setting build_settings here would
  # update Pods.xcodeproj but not the .xcconfig the Runner target
  # actually reads. Same pattern as the thermion CFLAGS patch above.
  #
  # SDK-conditional because the xcframework slices live in different
  # subdirectories (device arm64 vs simulator arm64+x86_64).
  device_force_load = '-force_load "$(PODS_ROOT)/onnxruntime-c/onnxruntime.xcframework/ios-arm64/onnxruntime.framework/onnxruntime"'
  sim_force_load = '-force_load "$(PODS_ROOT)/onnxruntime-c/onnxruntime.xcframework/ios-arm64_x86_64-simulator/onnxruntime.framework/onnxruntime"'
  marker = 'onnxruntime.xcframework'
  Dir[File.join(installer.config.installation_root, 'Pods/Target Support Files/Pods-Runner/*.xcconfig')].each do |xcconfig|
    contents = File.read(xcconfig)
    appended = contents.dup

    # 1) Strip `-l"onnxruntime-objc"`. The `onnxruntime` Flutter plugin
    #    1.4.1 has zero Obj-C / Swift source files in its iOS folder —
    #    it goes straight to C via dart:ffi. The podspec declares
    #    onnxruntime-objc as a dependency only to transitively pull in
    #    onnxruntime-c. CocoaPods then dutifully adds
    #    `-l"onnxruntime-objc"` to Pods-Runner's OTHER_LDFLAGS,
    #    re-importing the C ABI a second time. Combined with our
    #    `-force_load` of onnxruntime.framework below, that produces
    #    duplicate-symbol linker errors.
    #    Dropping the `-l onnxruntime-objc` is safe: no Obj-C code in
    #    this app references the wrapper's classes, and the C surface
    #    is provided by the framework we force-load.
    appended = appended.gsub(/ -l"onnxruntime-objc"/, '')

    # 1b) Strip `-framework "onnxruntime"`. CocoaPods adds it because
    #     onnxruntime-c declares the framework as a `vendored_framework`,
    #     and the `-framework F` linker flag resolves to exactly the
    #     same `onnxruntime.framework/onnxruntime` binary that our
    #     `-force_load` below also pulls in. Linker sees the same
    #     archive listed twice → 25 duplicate symbols. force_load alone
    #     is enough: it both resolves the framework and retains every
    #     symbol for dart:ffi lookup.
    appended = appended.gsub(/ -framework "onnxruntime"/, '')

    # 2) Append force_load only if not already there (idempotent on
    #    repeat `pod install`).
    unless contents.include?(marker)
      [
        [/^OTHER_LDFLAGS\[sdk=iphoneos\*\] = (.*)$/, device_force_load],
        [/^OTHER_LDFLAGS\[sdk=iphonesimulator\*\] = (.*)$/, sim_force_load],
      ].each do |pattern, flag|
        if appended.match?(pattern)
          appended = appended.sub(pattern) { |m| "#{m} #{flag}" }
        else
          sdk = flag.include?('simulator') ? 'iphonesimulator*' : 'iphoneos*'
          appended += "\nOTHER_LDFLAGS[sdk=#{sdk}] = $(inherited) #{flag}\n"
        end
      end
    end

    File.write(xcconfig, appended) if appended != contents
  end

  # ── XRSLAM official RD-VIO core ──────────────────────────────────────
  #
  # 和上面 onnxruntime 同一个问题、同一条路:Dart 侧用
  # DynamicLibrary.process().lookup('XRSLAMCreate') 取符号,静态链接器看不到
  # 任何引用就会把它们 dead-strip 掉,运行时 lookup 返回 NULL。
  #
  # ⚠️ 为什么不写在 xrslam.podspec 的 user_target_xcconfig 里:
  #   两个 pod 同时设 OTHER_LDFLAGS[sdk=iphoneos*] 时,CocoaPods 视其为单值设置,
  #   发现冲突就**整槽丢弃**。实测:那样做会让 aether3d_ffi 的 -force_load 与
  #   整个 -Wl,-u 列表在设备构建里全部消失(去掉 xrslam 立刻恢复)。
  #   不会编译报错,只会静默丢符号 —— 与本文件上方 onnxruntime 那段同类。
  #
  # Algorithm authority is the unmodified OpenXRLab generic C++ core built from
  # 4beb1a942f33da9afbfae2d70e2c641cfc2bb675 with XRSLAM_IOS and internal
  # threading both off. iOS/Android share Ceres 1.14 and OpenCV 4.0.1.
  # official calls but must not add or replace algorithm entry points.
  xrslam_dir = '$(PODS_ROOT)/../../vendor/xrslam/libs/ios-arm64'
  # [bench 2026-09-02] 线程化实验臂切换。PW_XRSLAM_BENCH_ARM 未设时走下面第一支,
  # 与本段加入前逐字节等价 —— 出货构建不受影响。两个 bench 臂仅供本机上机对照,
  # 绝不可进出货流程:它们的 threading 是 true,与生产档 pocketworld_hardened_generic
  # 的 threading:false 不是同一个执行架构。receipt 见同目录 *.receipt.json。
  xrslam_bench_arm = ENV['PW_XRSLAM_BENCH_ARM'].to_s
  xrslam_lib = case xrslam_bench_arm
               when '' then 'libxrslam_generic_4beb1a9.a'
               when 'thrnogate' then 'libxrslam_thrnogate_4beb1a9.a'
               when 'thrbp' then 'libxrslam_thrbp_4beb1a9.a'
               else raise "unknown PW_XRSLAM_BENCH_ARM=#{xrslam_bench_arm}"
               end
  xrslam_sym_names = %w[
    XRSLAMCreate XRSLAMDestroy XRSLAMRunOneFrame
    XRSLAMPushSensorData XRSLAMGetResult
  ]
  # bench 臂多导出一个排队深度遥测符号(生产 exported_abi 五符号之外),默认档不加。
  xrslam_sym_names += %w[XRSLAMGetPendingWorkerFrames] unless xrslam_bench_arm.empty?
  xrslam_marker = xrslam_lib
  xrslam_syms = xrslam_sym_names.map { |n| "-Wl,-u,_#{n}" }.join(' ')
  xrslam_exports = xrslam_sym_names.map { |n| "-Wl,-exported_symbol,_#{n}" }.join(' ')
  xrslam_flags = "-force_load \"#{xrslam_dir}/#{xrslam_lib}\" " \
                 "\"#{xrslam_dir}/libceres_official_1_14.a\" " \
                 "\"#{xrslam_dir}/libopencv_generic_4_0_1.a\" " \
                 "#{xrslam_syms} #{xrslam_exports}"

  Dir[File.join(installer.config.installation_root, 'Pods/Target Support Files/Pods-Runner/*.xcconfig')].each do |xcconfig|
    contents = File.read(xcconfig)
    next if contents.include?(xrslam_marker)   # 幂等
    pattern = /^OTHER_LDFLAGS\[sdk=iphoneos\*\] = (.*)$/
    appended = if contents.match?(pattern)
                 contents.sub(pattern) { |m| "#{m} #{xrslam_flags}" }
               else
                 contents + "\nOTHER_LDFLAGS[sdk=iphoneos*] = $(inherited) #{xrslam_flags}\n"
               end
    File.write(xcconfig, appended) if appended != contents
  end
end

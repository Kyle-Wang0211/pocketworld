+  echo "FAIL: missing iOS Dawn generated headers: $PWOFFICIAL_DAWN_GEN_INCLUDE" >&2
+  exit 66
+}
+[ -f "$PWOFFICIAL_DAWN_SRC_INCLUDE/webgpu/webgpu_cpp.h" ] || {
+  echo "FAIL: missing Dawn source headers: $PWOFFICIAL_DAWN_SRC_INCLUDE" >&2
+  exit 66
+}

+constexpr char kWgslTiledPlain[] = R"WGSL(
+const INV_SQ_NORM : f32 = 0.000003814697265625; // 1/262144
+
+struct Params {
+  numA : u32,
+  numB : u32,
+  maxRatio : f32,
+  maxDistance : f32,
+  numWg : u32,
+  rowBase : u32,
+  pad1 : u32,
+  pad2 : u32,

  bool v = false;
  if ((bd <= (*tint_module_vars.U).maxDistance)) {
    v = (bd < ((*tint_module_vars.U).maxRatio * sd));
  } else {
    v = false;
  }
  if (v) {
    return bestIndex;
  }
  return -1;
}

uint tint_dot(uint4 lhs, uint4 rhs) {
  return ((((lhs * rhs).x + (lhs * rhs).y) + (lhs * rhs).z) + (lhs * rhs).w);
}

